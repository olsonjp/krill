# env file
.env

### BEGIN vim gitignore ###
# Swap
[._]*.s[a-v][a-z]
!*.svg  # comment out if you don't need vector files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~
### END vim gitignore ###
**/__pycache__/

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Virtualenv
.venv
venv

# Sensitive data files
*.csv
!tests/data/anonymized_test_data.csv
*.xlsx
*.xls
*.sql
!init.sql
*.db
*.sqlite
*.sqlite3

